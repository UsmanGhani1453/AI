# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored, so machine-specific paths never get committed.

# Path to the local base model directory (e.g. a downloaded
# Qwen3-4B-Instruct-2507 checkpoint).
MODEL_PATH=./models/Qwen3-4B-Instruct-2507

# Where the trained LoRA adapter is saved to / loaded from.
OUTPUT_DIR=./training/output

# --- Optional training hyperparameter overrides ---
# NUM_TRAIN_EPOCHS=3
# LEARNING_RATE=2e-4
# TRAIN_BATCH_SIZE=1
# GRAD_ACCUM_STEPS=8
# LORA_R=16
# LORA_ALPHA=32
# LORA_DROPOUT=0.05

# --- Optional generation defaults (inference.py) ---
# MAX_NEW_TOKENS=220
# TEMPERATURE=0.7
# TOP_P=0.9
# REPETITION_PENALTY=1.1
